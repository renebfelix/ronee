# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto Firebase.
# Firebase Console → Configurações do projeto → Seus apps → App da Web → Configuração do SDK.
RONEE_NEXT_PUBLIC_FIREBASE_API_KEY=
RONEE_NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
RONEE_NEXT_PUBLIC_FIREBASE_PROJECT_ID=
RONEE_NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
RONEE_NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
RONEE_NEXT_PUBLIC_FIREBASE_APP_ID=
RONEE_NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
