# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto Firebase.
# Firebase Console → Configurações do projeto → Seus apps → App da Web → Configuração do SDK.
RONEE_NEXT_PUBLIC_FIREBASE_API_KEY=
RONEE_NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
RONEE_NEXT_PUBLIC_FIREBASE_PROJECT_ID=
RONEE_NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
RONEE_NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
RONEE_NEXT_PUBLIC_FIREBASE_APP_ID=
RONEE_NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Chave AES-256 do cofre de senhas (32 bytes em base64). Gere uma vez e NUNCA troque,
# senão as senhas já salvas não poderão mais ser decifradas. Para gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RONEE_NEXT_PUBLIC_VAULT_KEY=

# Chave da API do ImgBB (fotos dos produtos da Lista de compras). Só é usada no servidor
# (rota /api/upload) — não coloque o prefixo NEXT_PUBLIC nem a adicione ao `env` do next.config.
# Gere em https://api.imgbb.com/
RONEE_NEXT_PUBLIC_IMGBB_API_KEY=

# Tarefas — resumo diário por push (Firebase Cloud Messaging)
# Chave VAPID pública: Configurações do projeto → Cloud Messaging → Certificados push da Web → Gerar par de chaves
RONEE_NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Conta de serviço (Configurações do projeto → Contas de serviço → Gerar nova chave privada),
# com o JSON inteiro em uma linha ou codificado em base64. Só no servidor — nunca exponha.
RONEE_NEXT_PUBLIC_FIREBASE_SERVICE_ACCOUNT=
# Segredo exigido por /api/cron/tarefas no cabeçalho "Authorization: Bearer <segredo>"
RONEE_NEXT_PUBLIC_CRON_SECRET=

# Agenda — feriados (nacionais, SP e cidade de São Paulo) da APIBrasil.pro.
# Crie a chave em https://apibrasil.pro (plano gratuito: 1.000 requisições/mês). Só no servidor.
RONEE_NEXT_PUBLIC_APIBRASIL_KEY=
