rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só acessa os próprios dados (ex.: users/{uid}/modules/finance/...).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Fatura pública de um responsável (espelho mantido pelo app do dono).
    // Só é lida pelo id (o link); nunca listada por terceiros.
    //   PRIVATE → só o dono
    //   EMAIL   → dono ou quem entrou com o Google usando o e-mail cadastrado (verificado)
    //   PUBLIC  → qualquer pessoa com o link
    function isOwner(data) {
      return request.auth != null && request.auth.uid == data.ownerUid;
    }
    function canView(data) {
      return data.mode == "PUBLIC"
        || isOwner(data)
        || (data.mode == "EMAIL"
            && request.auth != null
            && request.auth.token.email_verified == true
            && request.auth.token.email.lower() == data.email);
    }

    match /shares/{shareId} {
      allow get: if canView(resource.data);
      allow list: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
      allow delete: if isOwner(resource.data);

      match /months/{ym} {
        allow get: if canView(get(/databases/$(database)/documents/shares/$(shareId)).data);
        allow list: if false;
        // O documento pai (no estado final do lote) precisa ser do mesmo dono.
        allow create, update: if isOwner(request.resource.data)
          && getAfter(/databases/$(database)/documents/shares/$(shareId)).data.ownerUid == request.auth.uid;
        allow delete: if isOwner(resource.data);
      }
    }
  }
}
